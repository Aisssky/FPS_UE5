# =====================================================================
# Unreal Engine 5 项目 .gitignore
# =====================================================================

# ---- IDE / 编辑器（Visual Studio / Rider / VSCode / Xcode）----
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.xcodeproj/
*.xcworkspace/
*.xcuserstate

# ---- 构建产物 / 引擎生成文件 ----
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# ---- 操作系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- WorkBuddy 工作区数据（本地记忆/临时数据，不入库）----
.workbuddy/

# ---- 施工蓝图与进度文档（本地留存，不入库）----
dos/

# ---- 日志 / 崩溃报告 ----
*.log
CrashReportClient/

# ---- 游戏内容资源（Content/FPS 逻辑/蓝图资源直提，其余大二进制后续走 Git LFS）----
Content/*
!Content/FPS/
